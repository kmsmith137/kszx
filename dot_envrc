# To "opt in" to using this, do 'ln -s dot_envrc .envrc'.
# See below for more context and setup.

if [[ -d "$CONDA_PREFIX/envs/kszx" ]]; then
  eval "$(conda shell.zsh activate kszx)"
else
  echo "direnv: WARNING — conda env 'kszx' not found, skipping"
fi

if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
else
  echo "direnv: WARNING — .venv not found, skipping"
fi


